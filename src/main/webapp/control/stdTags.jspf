<%-- Standard tag declarations, statically included by every page.
     JSTL 1.2 (Tomcat 9 / Java EE 8) URIs. The legacy Jakarta mailer2 ("mt") and
     O'Reilly ("ora") taglibs are replaced by compatible tag files in
     /WEB-INF/tags so existing pages keep working. --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="mt" tagdir="/WEB-INF/tags/mt" %>
<%@ taglib prefix="ora" tagdir="/WEB-INF/tags/ora" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags/ui" %>
