<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tomcat context for BuildTrees.

  path="/buildtrees" is the context path NetBeans uses when you press Run
  (Tomcat itself uses the WAR/folder name, which is also "buildtrees").

  Database connection settings are NOT stored here: appconfig.PoolFactory takes
  them from buildtrees.properties - by default
      %USERPROFILE%\.buildtrees\buildtrees.properties      (Windows)
      ~/.buildtrees/buildtrees.properties                  (Linux)
  or from -Dbuildtrees.db.* JVM options / BUILDTREES_DB_* environment variables.
  See README.md and buildtrees-local.properties.example.
-->
<Context path="/buildtrees">
    <Resource name="jdbc/LinkedDB"
              auth="Container"
              type="javax.sql.DataSource"
              factory="appconfig.PoolFactory"
              initialSize="2"
              maxActive="30"
              maxIdle="10"
              minIdle="2"
              maxWait="10000"
              defaultAutoCommit="true"
              commitOnReturn="true"
              jdbcInterceptors="ConnectionState;StatementFinalizer"
              testOnBorrow="true"
              validationQuery="SELECT 1"
              validationInterval="30000"
              removeAbandoned="true"
              removeAbandonedTimeout="120"
              logAbandoned="true"/>
</Context>
