google_color_url = "008000";
//--></script>
<script type="text/javascript"
  src="http://pagead2.googlesyndication.com/pagead/show_ads.js">
</script>
					</c:if>
				</div>
			</td>
		</tr></table>
	</div>
	<div id="footnotes">
