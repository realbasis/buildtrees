<%@ page contentType="text/html; charset=iso-8859-1" language="java" import="java.sql.*" errorPage="" %>
<html>
<head>
<!-- TemplateBeginEditable name="doctitle" -->
<title>Family Tree Builder..Mankind Connected</title>
<!-- TemplateEndEditable -->
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<link href="../css/linked.css" rel="stylesheet" type="text/css">
<%@include file="/control/stdTags.jspf" %>
<c:set var="theURI" value="${pageContext.request.requestURI}" />
<c:set var="theURL" value="${pageContext.request.requestURL}" />
<c:if test="${languageBean == null}">
	<jsp:useBean id="languageBean" class="value.LanguageBean" scope="session" />
</c:if>
<!-- TemplateBeginEditable name="head" -->
<!-- TemplateEndEditable -->
</head>

<body>

<table align="center" class="noborder"><tr><td>
<div id="main">
	<div id="banner" align="center">
		<table align="center" width="100%">
			<tr>
				<td align="left">
					<c:choose>
						<c:when test="${flag == 7}">
							<a href="../main.jsp"><img style="border:none; text-decoration:none" src="../images/buildtrees_logo2.png"></a>
						</c:when>
						<c:otherwise>
							<a href="../index.jsp"><img style="border:none; text-decoration:none" src="../images/buildtrees_logo2.png"></a>
						</c:otherwise>
					</c:choose>
				</td>
				<td>
					<table align="center">
						<tr>
							<td align="center">
							<c:if test="${flag == null}">
								<p>
<script type="text/javascript"><!--
google_ad_client = "pub-3538041140037139";
google_ad_width = 468;
google_ad_height = 60;
google_ad_format = "468x60_as";
google_ad_type = "image";
//2007-02-22: investment club
google_ad_channel = "3833421812";
google_color_border = "FFFFFF";
google_color_bg = "FFFFFF";
google_color_link = "0000FF";
google_color_text = "000000";
google_color_url = "008000";
//--></script>
<script type="text/javascript"
  src="http://pagead2.googlesyndication.com/pagead/show_ads.js">
</script>
								</p>
							</c:if>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</div>
	<!--
	<div id="menu">
	</div>
	-->
	<div id="content">
		<table align="center" width="100%"><tr>
			<td valign="top" align="left">
				<div id="vmenu">
					<table class="noborder" align="center">
						<c:if test="${flag == null}">
						<c:choose>
							<c:when test="${(fn:endsWith(theURI, 'index.jsp')) || (fn:endsWith(theURI, 'Linked/'))}">
								<tr><td><li> > ${languageBean.home}</li></td></tr>
							</c:when>
							<c:otherwise>
								<tr><td><li> <a href="../index.jsp">${languageBean.home}</a></li></td></tr>
							</c:otherwise>
						</c:choose>
						</c:if>
						<c:if test="${flag == 7}">
							<tr><td>
								<p style="text-align:center; color:green; font-style:italic; padding:5px 0 5px 0">
									"${myname}"
									<br>
									You're logged in
								</p>
							</td></tr>
							<c:choose>
								<c:when test="${fn:endsWith(theURI, 'profile.jsp')}">
									<tr><td><li> > My settings</li></td></tr>
								</c:when>
								<c:otherwise>
									<tr><td><li> <a href="../profile.jsp">My settings</a></li></td></tr>
								</c:otherwise>
							</c:choose>
							
							<c:choose>
								<c:when test="${fn:endsWith(theURI, 'trees.jsp')}">
									<tr><td><li> > Trees</li></td></tr>
								</c:when>
								<c:otherwise>
									<tr><td><li> <a href="../trees.jsp">Trees</a></li></td></tr>
								</c:otherwise>
							</c:choose>
							<c:if test="${fn:endsWith(theURI, 'mytree.jsp')}">
								<tr><td><li style="margin-left:10px"> > My tree</li></td></tr>
							</c:if>
							
							<c:choose>
								<c:when test="${fn:endsWith(theURI, 'search.jsp')}">
									<tr><td><li> > Search trees</li></td></tr>
								</c:when>
								<c:otherwise>
									<tr><td><li> <a href="../search.jsp">Search trees</a></li></td></tr>
								</c:otherwise>
							</c:choose>
							
							<c:if test="${fn:endsWith(theURI, 'invite.jsp')}">
								<c:if test="${param.other != true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="accountOwner" value="${param.accountOwner}" />
										<c:param name="emailo" value="${param.emailo}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
								</c:if>
								<c:if test="${param.other == true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
										<c:param name="treeID" value="${param.treeID}" />
										<c:param name="other" value="true" />
										<c:param name="accountOwner" value="${param.accountOwner}" />
										<c:param name="emailo" value="${param.emailo}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
								<tr><td><li style="margin-left:10px"> <a href="<c:out value=""/>">My tree ${listmytreeUrl}</a></li></td></tr>
								</c:if>
								<tr><td><li style="margin-left:20px"> > Email guest</li></td></tr>
							</c:if>
							
							<c:if test="${fn:endsWith(theURI, 'calendar.jsp')}">
								<c:if test="${param.other != true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
									</c:url>
								</c:if>
								<c:if test="${param.other == true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="other" value="true" />
										<c:param name="accountOwner" value="${param.accountOwner}" />
										<c:param name="emailo" value="${param.emailo}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
								</c:if>
								<!--
								<tr><td><li style="margin-left:10px"> <a href="<c:out value="${listmytreeUrl}"/>">My tree</a></li></td></tr>
								-->
								<tr><td><li style="margin-left:20px"> > Calendar</li></td></tr>
							</c:if>
							
							<c:if test="${fn:endsWith(theURI, 'people.jsp') && param.ref == null}">
								<c:if test="${param.other != true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
								</c:if>
								<c:if test="${param.other == true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="other" value="true" />
										<c:param name="accountOwner" value="${param.accountOwner}" />
										<c:param name="emailo" value="${param.emailo}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
								</c:if>
								<!--
								<tr><td><li style="margin-left:10px"> <a href="<c:out value="${listmytreeUrl}"/>">My tree</a></li></td></tr>
								-->
								<tr><td><li style="margin-left:20px"> > Members</li></td></tr>
							</c:if>
							<c:if test="${fn:endsWith(theURI, 'people.jsp') && param.ref >= 0}">
								<c:if test="${param.other != true}">
								<c:url var="listmytreeUrl" value="/mytree.jsp">
								    <c:param name="ref" value="1" />
								    <c:param name="treeID" value="${param.treeID}" />
									<c:param name="name" value="${param.name}" />
								</c:url>
								<c:url var="listmembersUrl" value="/people.jsp">
								    <c:param name="treeID" value="${param.treeID}" />
									<c:param name="name" value="${param.name}" />
								</c:url>
								</c:if>
								<c:if test="${param.other == true}">
									<c:url var="listmytreeUrl" value="/mytree.jsp">
									    <c:param name="ref" value="1" />
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="other" value="true" />
										<c:param name="accountOwner" value="${param.accountOwner}" />
										<c:param name="emailo" value="${param.emailo}" />
										<c:param name="name" value="${param.name}" />
									</c:url>
									<c:url var="listmembersUrl" value="/people.jsp">
									    <c:param name="treeID" value="${param.treeID}" />
										<c:param name="name" value="${param.name}" />
										<c:param name="other" value="true" />
									</c:url>
								</c:if>
								<!--
								<tr><td><li style="margin-left:10px"> <a href="<c:out value="${listmytreeUrl}"/>">My tree</a></li></td></tr>
								-->
<!--								<tr><td><li style="margin-left:20px"> <a href="<c:out value="${listmembersUrl}"/>">Members</a></li></td></tr> -->
								<tr><td><li style="margin-left:20px"> > Members</li></td></tr>
							</c:if>
						</c:if>
						<c:if test="${flag == null}">
						<!--
						<c:choose>
							<c:when test="${fn:endsWith(theURI, 'aboutus.jsp')}">
								<tr><td><li> > About us</li></td></tr>
							</c:when>
							<c:otherwise>
								<tr><td><li> <a href="aboutus.jsp">About us</a></li></td></tr>
							</c:otherwise>
						</c:choose>
						-->
						
						<!--
						<c:choose>
							<c:when test="${fn:endsWith(theURI, 'networks.jsp')}">
								<tr><td><li> > Networks</li></td></tr>
							</c:when>
							<c:otherwise>
								<tr><td><li> <a href="../networks.jsp">Networks</a></li></td></tr>
							</c:otherwise>
						</c:choose>
						-->
						<c:choose>
							<c:when test="${fn:endsWith(theURI, 'contactus.jsp')}">
								<tr><td><li> > ${languageBean.contactUs}</li></td></tr>
							</c:when>
							<c:otherwise>
								<tr><td><li> <a href="../contactus.jsp">${languageBean.contactUs}</a></li></td></tr>
							</c:otherwise>
						</c:choose>
						</c:if>
						<c:if test="${flag != 7}">
							<c:if test="${fn:endsWith(theURI, 'signup.jsp')}">
								<tr><td><li> > ${languageBean.signup}</li></td></tr>
							</c:if>
						</c:if>
						<c:if test="${flag == 7}">
							<tr><td><li> <a href="../control/logout.jsp">Logout</a></li></td></tr>
							<tr><td align="center" style="color:green">
								<br>
								need help? email us at
								<br>
								<a href="mailto:buildtrees@realbasis.com">buildtrees@realbasis.com</a>
								<br>
								<br>
							</td></tr>
						</c:if>
					</table>
					
					<c:if test="${fn:endsWith(theURI, 'signup.jsp') == false && fn:endsWith(theURI, 'forgotPassword.jsp') == false}">
						<c:if test="${flag != 7}">
						<table class="noborder" align="center" style="margin-top:20px;">
							<form action="../control/authenticate.jsp" name="loginForm" method="post">
								<tr><td align="center"><div class="style1">${fn:escapeXml(param.errors)}</div></td></tr>
								<tr><td align="center"  style="color:green"> ${languageBean.email}</td></tr>
								<tr><td align="center"> <input type="text" name="email" size="20" value="${param.email}"></td></tr>
								<tr><td align="center"  style="color:green">  ${languageBean.password}</td></tr>
								<tr><td align="center"> <input type="password" name="password" size="20"></td></tr>
								<tr><td align="center">
									<input type="submit" name="login" value="${languageBean.login}" onClick="loginForm.login.value='Login...'" style="margin-top:10px; margin-bottom:10px">
								</td></tr>
								<tr><td align="center"> <a href="../forgotPassword.jsp">${languageBean.forgotPassword}</a></td></tr>
								<input type="hidden" name="goodBrowser" value="true">
							</form>
						<c:choose>
							<c:when test="${fn:endsWith(theURI, 'signup.jsp')}">
								<tr><td align="center">${languageBean.signup}</td></tr>
							</c:when>
							<c:otherwise>
								<tr><td align="center"><a href="../signup.jsp">${languageBean.signup}</a></td></tr>
							</c:otherwise>
						</c:choose>
						</table>
						</c:if>
					</c:if>
						<table class="noborder" align="center" style="margin-top:20px;">
							<tr><td align="center">
								<form action="../control/doLanguage.jsp" method="post" name="changeLanguage">
									<select name="language" onChange="changeLanguage.submit()">
										<c:forEach items="${languageBean.list}" var="it">
											<c:choose>
											<c:when test="${languageBean.language == it.Cle0}">
												<option value="${it.Cle0}" selected="selected">${it.Cle1}</option>
											</c:when>
											<c:otherwise>
												<option value="${it.Cle0}">${it.Cle1}</option>
											</c:otherwise>
											</c:choose>
										</c:forEach>
									</select>
									<input type="hidden" name="theURL" value="${theURL}">
								</form>
							</td></tr>
						</table>
				</div>
				
				<div id="vmenu2">
					<c:if test="${fn:endsWith(theURI, 'people.jsp')}">
						<div>
							<sql:query var="result">
								Select * From People Where TreeID = ? Order By LastName
								<sql:param value="${param.treeID}"/>
							</sql:query>
							<!-- select box for family members -->
							<c:if test="${param.ref != 0 && param.ref != null && param.pos == null}">
								<c:if test="${result.rowCount > 0}">
									<form action="../people.jsp" method="post" name="viewForm">
										<select name="peopleID" onChange="viewForm.submit()">
											<c:forEach items="${result.rows}" var="row">
												<c:if test="${param.other != true}">
													<c:if test="${row.AccountID > 0}">
														<c:set var="sign" value="*" />
													</c:if>
													<c:if test="${row.AccountID <= 0}">
														<c:set var="sign" value="" />
													</c:if>
												</c:if>
												<c:if test="${param.other == true}">
													<c:choose>
														<c:when test="${row.AccountID == accountID}">
															<c:set var="sign" value="^" />
														</c:when>
														<c:otherwise>
															<c:set var="sign" value="" />
														</c:otherwise>
													</c:choose>
												</c:if>
												<c:choose>
													<c:when test="${param.peopleID == row.PeopleID}">
														<option value="${row.PeopleID}" selected="selected">${sign}${row.LastName}, ${row.FirstName}</option>
													</c:when>
													<c:otherwise>
														<option value="${row.PeopleID}">${sign}${row.LastName}, ${row.FirstName}</option>
													</c:otherwise>
												</c:choose>
											</c:forEach>
										</select>
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</c:if>
							</c:if>
						</div>
					</c:if>

					<!-- button to add family member -->
					<c:if test="${fn:endsWith(theURI, 'people.jsp') || (fn:endsWith(theURI, 'mytree.jsp') && param.ref == 1)}">
						<c:if test="${param.ref != 0 && param.pos == null}">						
						<div>
								<form action="../people.jsp" method="post">
									<input type="submit" value="Add Member" style="font-size:10px; width:120px">
									<input type="hidden" name="treeID" value="${param.treeID}">
									<input type="hidden" name="name" value="${param.name}">
									<input type="hidden" name="peopleID" value="${param.peopleID}">
									<input type="hidden" name="ref" value="0">
									<input type="hidden" name="other" value="${param.other}">
									<input type="hidden" name="accountOwner" value="${param.accountOwner}">
									<input type="hidden" name="emailo" value="${param.emailo}">
								</form>
						</div>
						</c:if>
					</c:if>
						
					<c:if test="${fn:endsWith(theURI, 'people.jsp')}">
						<!-- button to update family of member -->
						<c:if test="${param.ref == 1 && param.pos == null}">
							<c:forEach items="${sets.rows}" end="0" var="line">
								<c:set var="otherAccountID" value="${line.AccountID}" />
								<c:set var="gender" value="${line.Gender}" />
							</c:forEach>
							<c:if test="${(param.other != true) || (param.other == true && otherAccountID == accountID && access == 'WRITE')}">
								<div>
								<form action="../control/updateTree.jsp" name="updateTreeForm" method="post">
									<input type="button" name="updateTree" value="Update Tree" onClick="updateTreeForm.updateTree.value='Processing...';updateTreeForm.submit()" style="font-size:10px; width:120px">
									<input type="hidden" name="treeID" value="${param.treeID}">
									<input type="hidden" name="name" value="${param.name}">
									<input type="hidden" name="peopleID" value="${param.peopleID}">
									<input type="hidden" name="gender" value="${gender}">
									<input type="hidden" name="ref" value="1">
									<input type="hidden" name="other" value="${param.other}">
									<input type="hidden" name="accountOwner" value="${param.accountOwner}">
									<input type="hidden" name="emailo" value="${param.emailo}">
								</form>
								</div>
								
								<!--
								<div style="margin-left:10px">
									<form action="people.jsp" method="post">
										<input type="submit" value="Add Parent" style="font-size:10px; width:80px">
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="peopleID" value="${param.peopleID}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="pos" value="0">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="type" value="parent">
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</div>
								<div style="margin-left:10px">
									<form action="people.jsp" method="post">
										<input type="submit" value="Add Spouse" style="font-size:10px; width:80px">
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="peopleID" value="${param.peopleID}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="pos" value="1">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="type" value="spouse">
										<c:if test="${gender == 'Male'}">
											<input type="hidden" name="title" value="Wife">
										</c:if>
										<c:if test="${gender == 'Female'}">
											<input type="hidden" name="title" value="Husband">
										</c:if>
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</div>
								<div style="margin-left:10px">
									<form action="people.jsp" method="post">
										<input type="submit" value="Add Child" style="font-size:10px; width:80px">
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="peopleID" value="${param.peopleID}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="pos" value="0">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="type" value="child">
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</div>
								<div style="margin-left:10px">
									<form action="people.jsp" method="post">
										<input type="submit" value="Add Sibling" style="font-size:10px; width:80px">
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="peopleID" value="${param.peopleID}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="pos" value="0">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="type" value="sibling">
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</div>
								<div style="margin-left:10px">
									<form action="people.jsp" method="post">
										<input type="submit" value="Add Friend" style="font-size:10px; width:80px">
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="peopleID" value="${param.peopleID}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="pos" value="0">
										<input type="hidden" name="other" value="${param.other}">
										<input type="hidden" name="type" value="other">
										<input type="hidden" name="accountOwner" value="${param.accountOwner}">
										<input type="hidden" name="emailo" value="${param.emailo}">
									</form>
								</div>
								-->
						
							</c:if>
						</c:if>
					</c:if>
					
					<!-- button to invite guest -->
					<!--
					<c:if test="${fn:endsWith(theURI, 'mytree.jsp')}">
						<div>
								<form action="invite.jsp" method="post">
									<input type="submit" value="Invite Guest" style="font-size:10px; width:120px">
									<input type="hidden" name="treeID" value="${param.treeID}">
									<input type="hidden" name="name" value="${param.name}">
									<input type="hidden" name="peopleID" value="${param.peopleID}">
									<input type="hidden" name="ref" value="1">
									<input type="hidden" name="other" value="${param.other}">
									<input type="hidden" name="accountOwner" value="${param.accountOwner}">
									<input type="hidden" name="emailo" value="${param.emailo}">
								</form>
						</div>
					</c:if>
					-->
					
					<c:if test="${fn:endsWith(theURI, 'people.jsp') || fn:endsWith(theURI, 'mytree.jsp')}">
						<!-- button to see calendar -->
						<div>
								<form action="../calendar.jsp" method="post">
									<input type="submit" value="Calendar" style="font-size:10px; width:120px">
									<input type="hidden" name="treeID" value="${param.treeID}">
									<input type="hidden" name="name" value="${param.name}">
									<input type="hidden" name="peopleID" value="${param.peopleID}">
									<input type="hidden" name="ref" value="1">
									<input type="hidden" name="other" value="${param.other}">
									<input type="hidden" name="accountOwner" value="${param.accountOwner}">
									<input type="hidden" name="emailo" value="${param.emailo}">
								</form>
						</div>
					</c:if>
					
					<c:if test="${fn:endsWith(theURI, 'viewtree.jsp')}">
						<div>
							<!-- select box for family members -->
							<c:if test="${param.ref != 0 && param.ref != null}">
								<sql:query var="result">
									Select * From People Where TreeID = ? Order By LastName
									<sql:param value="${param.treeID}"/>
								</sql:query>
								<c:if test="${result.rowCount > 0}">
									<form action="../viewtree.jsp" method="post" name="viewForm">
										<select name="peopleID" onChange="viewForm.submit()">
											<c:forEach items="${result.rows}" var="row">
												<c:choose>
													<c:when test="${param.peopleID == row.PeopleID}">
														<option value="${row.PeopleID}" selected="selected">${sign}${row.LastName}, ${row.FirstName}</option>
													</c:when>
													<c:otherwise>
														<option value="${row.PeopleID}">${sign}${row.LastName}, ${row.FirstName}</option>
													</c:otherwise>
												</c:choose>
											</c:forEach>
										</select>
										<input type="hidden" name="treeID" value="${param.treeID}">
										<input type="hidden" name="name" value="${param.name}">
										<input type="hidden" name="ref" value="1">
										<input type="hidden" name="nameSearch" value="${param.nameSearch}">
									</form>
								</c:if>
							</c:if>
						</div>
						<c:if test="${flag == 7}">
							<!-- request invitation to family tree -->
							<sql:query var="treequery">
								SELECT Trees.*, Accounts.Email, Accounts.Name AS 'AccountName' 
								FROM Trees, Accounts 
								Where Accounts.AccountID = Trees.AccountID And TreeID = ?
								<sql:param value="${param.treeID}"/>
							</sql:query>
							<c:forEach items="${treequery.rows}" var="row">
							<div>
								<form action="../control/doNotify.jsp" method="post" name="notifyForm">
									<input type="submit" value="Request Access" name="notifyButton" style="font-size:10px" onClick="notifyForm.notifyButton.value='Processing...'">
									<input type="hidden" name="treeID" value="${param.treeID}">
									<input type="hidden" name="ownerEmail" value="${row.Email}">
									<input type="hidden" name="accountIDg" value="${accountID}">
									<input type="hidden" name="accountIDo" value="${row.AccountID}">
								</form>
							</div>
							</c:forEach>
						</c:if>
					</c:if>
					
				</div>
			</td>
			<td valign="top" align="center">
				<div id="crt">
			  <!-- TemplateBeginEditable name="EditRegion3" -->
			  
			  <!-- TemplateEndEditable -->
			  	</div>
			 </td>
			<td valign="top" align="right">
				<div id="rvmenu">
					<c:if test="${flag == null}">
<script type="text/javascript"><!--
google_ad_client = "pub-3538041140037139";
google_ad_width = 120;
google_ad_height = 600;
google_ad_format = "120x600_as";
